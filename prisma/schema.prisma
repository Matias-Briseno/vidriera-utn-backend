generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum rol_usuario {
  estudiante
  docente
  bedelia
  directivo
}

enum condicion_academica {
  alumno
  egresado
}

enum rol_participacion {
  integrante
  director
  codirector
}

enum estado_tesis {
  pendiente
  aprobada
  rechazada
}

model tecnicaturas {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(150)
  descripcion String
  imagen_url  String
  tesis       tesis[]
  users       users[]
}

model users {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(100)
  apellido            String                @db.VarChar(100)
  foto_url            String?
  nro_legajo          String                @unique @db.VarChar(30)
  email               String                @unique @db.VarChar(150)
  password_hash       String?
  tecnicatura_id      Int?
  condicion_academica condicion_academica?
  rol                 rol_usuario           @default(estudiante)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  tecnicaturas        tecnicaturas?         @relation(fields: [tecnicatura_id], references: [id], onDelete: Restrict, map: "fk_users_tecnicatura")
  tesis_participantes tesis_participantes[]

  @@index([tecnicatura_id], map: "idx_users_tecnicatura_id")
}

model tesis {
  id                   Int                   @id @default(autoincrement())
  tecnicatura_id       Int
  titulo               String                @db.VarChar(255)
  tema                 String                @db.VarChar(120)
  resumen              String
  estado               estado_tesis          @default(pendiente)
  vistas               Int                   @default(0)
  fecha_publicacion    DateTime              @db.Date
  miniatura_url        String
  imagen_principal_url String
  url_pdf              String?
  url_video            String?
  url_github           String?
  url_youtube          String?
  tecnicaturas         tecnicaturas          @relation(fields: [tecnicatura_id], references: [id], onDelete: Restrict, map: "fk_tesis_tecnicatura")
  tesis_galeria        tesis_galeria[]
  tesis_participantes  tesis_participantes[]

  @@index([tecnicatura_id], map: "idx_tesis_tecnicatura_id")
  @@index([estado], map: "idx_tesis_estado")
}

model tesis_galeria {
  id         Int    @id @default(autoincrement())
  tesis_id   Int
  imagen_url String
  orden      Int    @default(1)
  tesis      tesis  @relation(fields: [tesis_id], references: [id], onDelete: Cascade, map: "fk_galeria_tesis")

  @@unique([tesis_id, orden], map: "uq_galeria_tesis_orden")
  @@index([tesis_id], map: "idx_galeria_tesis_id")
}

model tesis_participantes {
  tesis_id          Int
  user_id           Int
  rol_participacion rol_participacion @default(integrante)
  tesis             tesis             @relation(fields: [tesis_id], references: [id], onDelete: Cascade, map: "fk_tp_tesis")
  users             users             @relation(fields: [user_id], references: [id], onDelete: Restrict, map: "fk_tp_user")

  @@id([tesis_id, user_id], map: "pk_tesis_participantes")
  @@index([user_id], map: "idx_tp_user_id")
}